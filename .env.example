# Local dev (outside Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/topainew

# Shared-token admin auth (see server/utils/adminAuth.ts) — replace with
# real per-user auth before this becomes a multi-admin product.
ADMIN_TOKEN=changeme-dev-token
ADMIN_PASSWORD=changeme-dev-password

NUXT_PUBLIC_SITE_URL=http://localhost:3000

# When running via `docker compose up`, DATABASE_URL is overridden to
# postgresql://postgres:postgres@postgres:5432/topainew automatically (see docker-compose.yml).
#
# ADMIN_TOKEN / ADMIN_PASSWORD are read directly in nuxt.config.ts's
# runtimeConfig, which is evaluated at BUILD time (`npm run build`, which
# runs inside the Docker image build step) — not at container start. So
# exporting ADMIN_TOKEN/ADMIN_PASSWORD before `docker compose up` has NO
# effect unless you also rebuild the image with them set. To change the
# admin password/token on an already-built image without rebuilding, export
# NUXT_ADMIN_TOKEN / NUXT_ADMIN_PASSWORD instead (see docker-compose.yml) —
# Nitro reads NUXT_-prefixed env vars fresh on every server start and they
# always override the build-time default.

# Stripe (guest post / link insert credits — see server/api/orders/credits.post.ts).
# Use test keys (sk_test_…) locally. The webhook secret comes from
# `stripe listen --forward-to localhost:3000/api/stripe/webhook` in dev, or from
# the webhook endpoint you create in the Stripe dashboard in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# DEV ONLY — skip Stripe: every promote order is marked PAID immediately and
# fulfilled (credits added, submitted tool created). Only `nuxt dev` honours it.
FAKE_PAYMENT=false

# true only when the app sits behind your own reverse proxy (nginx, Caddy…) that
# appends the client IP to X-Forwarded-For. Ad clicks are counted once per IP per
# day; without a trusted proxy the header is ignored (clients could fake it).
TRUST_PROXY=false

# Sign in with Google — OAuth 2.0 Client ID (type "Web application") from
# Google Cloud Console → APIs & Services → Credentials. Add every site origin
# (http://localhost:3000, https://your-domain) to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
