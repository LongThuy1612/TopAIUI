# Local dev (outside Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/topainew

# x-admin-token for server-to-server callers (crawl scripts posting to /api/toolify,
# /api/ph — see server/utils/adminAuth.ts). Only accepted when at least 24 characters
# and not a placeholder: empty = no admin token at all (admins still sign in).
# Generate one with `openssl rand -hex 32`.
ADMIN_TOKEN=
ADMIN_PASSWORD=

NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret that signs login tokens. Required by docker-compose (left empty here on
# purpose so a copied file can't ship a known value) — generate one with
# `openssl rand -hex 32`; any value works for local dev. Changing it signs every user out.
USER_TOKEN_SECRET=

# When running via `docker compose up`, DATABASE_URL is overridden to
# postgresql://postgres:postgres@postgres:5432/topainew automatically (see docker-compose.yml).
#
# ADMIN_TOKEN / ADMIN_PASSWORD are read directly in nuxt.config.ts's
# runtimeConfig, which is evaluated at BUILD time (`npm run build`, which
# runs inside the Docker image build step) — not at container start. So
# exporting ADMIN_TOKEN/ADMIN_PASSWORD before `docker compose up` has NO
# effect unless you also rebuild the image with them set. To change the
# admin password/token on an already-built image without rebuilding, export
# NUXT_ADMIN_TOKEN / NUXT_ADMIN_PASSWORD instead (see docker-compose.yml) —
# Nitro reads NUXT_-prefixed env vars fresh on every server start and they
# always override the build-time default.

# Stripe (guest post / link insert credits — see server/api/orders/credits.post.ts).
# Use test keys (sk_test_…) locally. The webhook secret comes from
# `stripe listen --forward-to localhost:3000/api/stripe/webhook` in dev, or from
# the webhook endpoint you create in the Stripe dashboard in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# false = Stripe checkout hidden on promote orders, PayPal only (the code is kept).
STRIPE_ENABLED=false

# PayPal — the main checkout: promote orders (server/utils/paypal.ts) and Research Plan
# subscriptions (server/utils/paypalSubscriptions.ts). REST app keys from
# developer.paypal.com → Apps & Credentials (Sandbox keys with PAYPAL_MODE=sandbox, Live
# keys with live). PAYPAL_WEBHOOK_ID: the ID of the webhook pointing to
# https://www.topaicollection.com/api/paypal/webhook, with the events
#   promote orders:  CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED,
#                    PAYMENT.CAPTURE.DENIED, PAYMENT.CAPTURE.DECLINED
#   Research Plans:  BILLING.SUBSCRIPTION.ACTIVATED, BILLING.SUBSCRIPTION.UPDATED,
#                    BILLING.SUBSCRIPTION.RE-ACTIVATED, BILLING.SUBSCRIPTION.SUSPENDED,
#                    BILLING.SUBSCRIPTION.CANCELLED, BILLING.SUBSCRIPTION.EXPIRED,
#                    BILLING.SUBSCRIPTION.PAYMENT.FAILED, PAYMENT.SALE.COMPLETED
# Empty client ID = no "Pay with PayPal" button.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# DEV ONLY — skip Stripe: every promote order is marked PAID immediately and
# fulfilled (credits added, submitted tool created). Only `nuxt dev` honours it.
FAKE_PAYMENT=false

# true only when the app sits behind your own reverse proxy (nginx, Caddy…) that
# appends the client IP to X-Forwarded-For. Ad clicks are counted once per IP per
# day; without a trusted proxy the header is ignored (clients could fake it).
TRUST_PROXY=false

# Sign in with Google — OAuth 2.0 Client ID (type "Web application") from
# Google Cloud Console → APIs & Services → Credentials. Add every site origin
# (http://localhost:3000, https://your-domain) to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Outgoing email (email confirmation + password reset links) over SMTP — any
# provider works: Gmail/Workspace (smtp.gmail.com:587 + an App Password),
# Resend (smtp.resend.com:465, user "resend"), Amazon SES, Postmark…
# Leave SMTP_HOST empty in dev: the emails are printed to the server console.
# Links in the emails use NUXT_PUBLIC_SITE_URL, so set it to the real domain.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TopAICollection <no-reply@topaicollection.com>"

# Inbox that gets an email for each new Contact-page message (Reply-To is the
# sender). Empty = the public address in shared/site.ts (SUPPORT_EMAIL).
CONTACT_INBOX=
