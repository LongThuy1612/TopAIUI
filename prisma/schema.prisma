generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PricingType {
  FREE
  FREEMIUM
  PAID
}

enum Role {
  USER
  MANAGER
  ADMIN
}

model Category {
  id         String   @id @default(cuid())
  handle     String?
  slug       String   @unique
  name       String
  icon       String   @default("🔧")
  url        String?
  parentId   String?
  isFeatured Boolean  @default(false)
  viewCount  Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tools        Tool[]
  translations CategoryTranslation[]

  @@map("Category")
}

model CategoryTranslation {
  id               String   @id @default(cuid())
  categoryId       String
  locale           String
  name             String
  description      String?
  seoTitle         String?
  seoDesc          String?
  isManualOverride Boolean  @default(false)
  updatedAt        DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, locale])
  @@map("CategoryTranslation")
}

model Tool {
  id                String      @id @default(cuid())
  slug              String      @unique
  url               String?
  timestamp         String?
  icon              String?
  logoUrl           String?
  screenshotUrl     String?
  videoUrl          String?
  images            Json?
  affiliateUrl      String?
  couponCode        String?
  pricingType       PricingType @default(FREEMIUM)
  website           String?
  toolifyUrl        String?
  twitterUrl        String?
  discordUrl        String?
  productHuntUrl    String?
  socialLinks       Json?
  isFeatured        Boolean     @default(false)
  isJustLaunched    Boolean     @default(false)
  isVerified        Boolean     @default(false)
  isFreeTool        Boolean     @default(false)
  isAd              Boolean     @default(false)
  adPriority        Int         @default(0)
  rejectionReason   String?
  monthlyTraffic    String?
  monthlyVisits     Float       @default(0)
  collectionCount   Int         @default(0)
  impressions       Float       @default(0)
  clicksOrganic     Float       @default(0)
  clicksPaid        Float       @default(0)
  domainAuthority   Int         @default(0)
  viewCount         Float       @default(0)
  clickCount        Float       @default(0)
  averageRating     Float       @default(0)
  reviewCount       Int         @default(0)
  reviewScore       Float       @default(0)
  ratingCount       Int         @default(0)
  upvoteCount       Int         @default(0)
  trafficRank       Int         @default(0)
  last6MonthGrowth  Float       @default(0)
  last3MonthGrowth  Float       @default(0)
  last1MonthGrowth  Float       @default(0)
  nuxtTraffic       Json?
  companyInfo       Json?
  attributes        Json?
  step1             Boolean     @default(false)
  step2             Boolean     @default(false)
  ownerId           String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?
  status            String      @default("PUBLISHED")
  name              String

  categories    Category[]
  translations  ToolTranslation[]
  faqs          Faq[]
  features      Feature[]
  pricingPlans  PricingPlan[]
  reviews       Review[]

  @@index([status])
  @@map("Tool")
}

model ToolTranslation {
  id                String   @id @default(cuid())
  toolId            String
  locale            String
  shortDesc         String?
  description       String?
  whatIs            String?
  howToUse          String?
  coreFeatures      String[]
  useCases          String[]
  isManualOverride  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tool Tool @relation(fields: [toolId], references: [id])

  @@unique([toolId, locale])
  @@map("ToolTranslation")
}

model Faq {
  id       String @id @default(cuid())
  toolId   String
  locale   String
  question String
  answer   String

  tool Tool @relation(fields: [toolId], references: [id])

  @@map("Faq")
}

model Feature {
  id      String @id @default(cuid())
  toolId  String
  locale  String
  content String

  tool Tool @relation(fields: [toolId], references: [id])

  @@map("Feature")
}

model PricingPlan {
  id       String   @id @default(cuid())
  toolId   String
  locale   String
  name     String
  price    String
  period   String
  features String[]

  tool Tool @relation(fields: [toolId], references: [id])

  @@map("PricingPlan")
}

model Review {
  id         String   @id @default(cuid())
  rating     Int
  comment    String?
  userId     String
  toolId     String
  locale     String
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  status     String   @default("PENDING")
  userInfo   Json?

  tool Tool @relation(fields: [toolId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@map("Review")
}

model Tag {
  id        String   @id @default(cuid())
  slug      String   @unique
  viewCount Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations TagTranslation[]

  @@map("Tag")
}

model TagTranslation {
  id               String   @id @default(cuid())
  tagId            String
  locale           String
  name             String
  isManualOverride Boolean  @default(false)
  updatedAt        DateTime @updatedAt

  tag Tag @relation(fields: [tagId], references: [id])

  @@unique([tagId, locale])
  @@map("TagTranslation")
}

model User {
  id                       String    @id @default(cuid())
  email                    String    @unique
  password                 String?
  name                     String?
  company                  String?
  country                  String?
  phone                    String?
  city                     String?
  state                    String?
  zip                      String?
  address                  String?
  vatNumber                String?
  role                     Role      @default(USER)
  emailVerified            Boolean   @default(false)
  verificationToken        String?
  verificationTokenExpiry  DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  credits                  Int       @default(0)
  usage                    Json?
  adCredits                Int       @default(0)
  linkCredits              Int       @default(0)
  postCredits              Int       @default(0)
  bio                      String?
  website                  String?
  stripeCustomerId         String?
  passwordChangedAt        DateTime?
  passwordResetToken       String?
  passwordResetTokenExpiry DateTime?
  isBanned                 Boolean   @default(false)
  deletedAt                DateTime?
  hasSetPassword           Boolean   @default(false)

  reviews Review[]

  @@map("User")
}

model Collection {
  id         String   @id @default(cuid())
  slug       String   @unique
  coverImage String?
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  translations CollectionTranslation[]

  @@map("Collection")
}

model CollectionTranslation {
  id               String   @id @default(cuid())
  collectionId     String
  locale           String
  title            String
  description      String?
  isManualOverride Boolean  @default(false)
  updatedAt        DateTime @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id])

  @@unique([collectionId, locale])
  @@map("CollectionTranslation")
}
