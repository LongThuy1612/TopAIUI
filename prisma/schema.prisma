generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PricingType {
  FREE
  FREEMIUM
  PAID
}

enum Role {
  USER
  MANAGER
  ADMIN
}

// Contact page: the subject picked on the form.
enum ContactSubject {
  GENERAL
  SUPPORT
  FEEDBACK
  PARTNERSHIP
  OTHER
}

// Contact message lifecycle: NEW until an admin replies (REPLIED) or closes it.
enum ContactStatus {
  NEW
  REPLIED
  CLOSED
}

// Dashboard → Feedback: the four choices on the form.
enum FeedbackType {
  FEATURE // request a new feature
  ISSUE   // report a problem
  BILLING // billing question
  OTHER
}

// Research Plan (Dashboard → Website Insights / Social Listening). Prices and quotas
// live in code (like the promote prices); the DB only names the plan.
enum ResearchPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum BillingInterval {
  MONTH
  YEAR
}

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Category {
  id         String   @id @default(cuid())
  handle     String?
  slug       String   @unique
  name       String?
  icon       String   @default("🔧")
  url        String?
  parentId   String?
  isFeatured Boolean  @default(false)
  viewCount  Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tools        Tool[] @relation("ToolToCategory")
  translations CategoryTranslation[]

  @@map("Category")
}

model CategoryTranslation {
  id               String   @id @default(cuid())
  categoryId       String
  locale           String
  name             String
  description      String?
  seoTitle         String?
  seoDesc          String?
  isManualOverride Boolean  @default(false)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, locale])
  @@map("CategoryTranslation")
}

model Tool {
  id                String      @id @default(cuid())
  slug              String      @unique
  url               String?
  timestamp         String?
  icon              String?
  logoUrl           String?
  screenshotUrl     String?
  videoUrl          String?
  images            Json?
  affiliateUrl      String?
  couponCode        String?
  pricingType       PricingType @default(FREEMIUM)
  website           String?
  toolifyUrl        String?
  twitterUrl        String?
  discordUrl        String?
  productHuntUrl    String?
  socialLinks       Json?
  isFeatured        Boolean     @default(false)
  isJustLaunched    Boolean     @default(false)
  isVerified        Boolean     @default(false)
  isFreeTool        Boolean     @default(false)
  isAd              Boolean     @default(false)
  adPriority        Int         @default(0)
  rejectionReason   String?
  monthlyTraffic    String?
  monthlyVisits     Float       @default(0)
  collectionCount   Int         @default(0)
  impressions       Float       @default(0)
  clicksOrganic     Float       @default(0)
  clicksPaid        Float       @default(0)
  domainAuthority   Int         @default(0)
  viewCount         Float       @default(0)
  clickCount        Float       @default(0)
  averageRating     Float       @default(0)
  reviewCount       Int         @default(0)
  reviewScore       Float       @default(0)
  ratingCount       Int         @default(0)
  upvoteCount       Int         @default(0)
  trafficRank       Int         @default(0)
  last6MonthGrowth  Float       @default(0)
  last3MonthGrowth  Float       @default(0)
  last1MonthGrowth  Float       @default(0)
  nuxtTraffic       Json?
  companyInfo       Json?
  attributes        Json?
  step1             Boolean     @default(false)
  step2             Boolean     @default(false)
  ownerId           String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?
  status            String      @default("PUBLISHED")
  name              String
  isApproved        Boolean     @default(false)
  addedOn           DateTime?
  region            String?
  source            String?
  monthlyRevenue    Float       @default(0)
  // User-submitted tools: AI content job for the crawler's sync-user-tool cron.
  // null = none, 0 = queued, 1 = done, -1 = failed (retried after cooldown), 2 = invalid
  aiSync            Int?
  // Failed runs of the current job — the crawler backs off and gives up after a few.
  // Reset to 0 whenever the site queues the job again.
  aiSyncAttempts    Int         @default(0)

  categories    Category[] @relation("ToolToCategory")
  tags          Tag[] @relation("ToolToTag")
  translations  ToolTranslation[]
  faqs          Faq[]
  features      Feature[]
  pricingPlans  PricingPlan[]
  reviews       Review[]
  updateRequests ToolUpdateRequest[]
  adCampaigns   AdCampaign[]
  saves         ToolSave[]

  @@index([status])
  // /new, /today, home "new" list: ORDER BY addedOn DESC NULLS LAST, id ASC.
  // The migration creates it as ("addedOn" DESC NULLS LAST, id) so Postgres
  // reads the first page straight off the index instead of sorting every tool.
  @@index([addedOn(sort: Desc), id])
  @@index([createdAt])
  @@index([aiSync])
  // "My AIs" / dashboard: WHERE ownerId = ? ORDER BY createdAt DESC.
  @@index([ownerId, createdAt])
  // Announcement bar on every page: featured=true, newest first, LIMIT 1.
  @@index([isFeatured, createdAt])
  // sort=rating (home "top rated", /most-featured).
  @@index([averageRating(sort: Desc)])
  // sort=name and sort=featured on category pages.
  @@index([name])
  @@index([isAd(sort: Desc), adPriority(sort: Desc), isFeatured(sort: Desc), viewCount(sort: Desc)])
  // Name search (?q= on /api/tools, /api/promote/tools, admin) is ILIKE '%q%',
  // which a btree can't serve; a trigram GIN index can.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Tool_name_trgm_idx")
  @@map("Tool")
}

model ToolTranslation {
  id                String   @id @default(cuid())
  toolId            String
  locale            String
  shortDesc         String?
  description       String?
  whatIs            String?
  howToUse          String?
  coreFeatures      String[]
  useCases          String[]
  isManualOverride  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tool Tool @relation(fields: [toolId], references: [id])

  @@unique([toolId, locale])
  @@map("ToolTranslation")
}

model Faq {
  id       String @id @default(cuid())
  toolId   String
  locale   String
  question String
  answer   String

  tool Tool @relation(fields: [toolId], references: [id])

  @@index([toolId, locale])
  @@map("Faq")
}

model Feature {
  id      String @id @default(cuid())
  toolId  String
  locale  String
  content String

  tool Tool @relation(fields: [toolId], references: [id])

  @@index([toolId])
  @@map("Feature")
}

model PricingPlan {
  id       String   @id @default(cuid())
  toolId   String
  locale   String
  name     String
  price    String
  period   String
  features String[]

  tool Tool @relation(fields: [toolId], references: [id])

  @@index([toolId, locale])
  @@map("PricingPlan")
}

model Review {
  id         String   @id @default(cuid())
  rating     Int
  comment    String?
  userId     String?
  toolId     String
  locale     String
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  status     String   @default("PENDING")
  userInfo   Json?

  tool Tool  @relation(fields: [toolId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([toolId, status, createdAt])
  // Review Manager: filter by status, newest first, plus the pending count.
  @@index([status, createdAt])
  @@map("Review")
}

model Tag {
  id        String   @id @default(cuid())
  slug      String   @unique
  viewCount Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations TagTranslation[]
  tools        Tool[] @relation("ToolToTag")

  @@map("Tag")
}

model TagTranslation {
  id               String   @id @default(cuid())
  tagId            String
  locale           String
  name             String
  isManualOverride Boolean  @default(false)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  tag Tag @relation(fields: [tagId], references: [id])

  @@unique([tagId, locale])
  @@map("TagTranslation")
}

model User {
  id                       String    @id @default(cuid())
  email                    String    @unique
  password                 String?
  name                     String?
  company                  String?
  country                  String?
  phone                    String?
  city                     String?
  state                    String?
  zip                      String?
  address                  String?
  vatNumber                String?
  role                     Role      @default(USER)
  emailVerified            Boolean   @default(false)
  verificationToken        String?
  verificationTokenExpiry  DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  credits                  Int       @default(0)
  usage                    Json?
  linkCredits              Int       @default(0)
  postCredits              Int       @default(0)
  bio                      String?
  website                  String?
  stripeCustomerId         String?
  passwordChangedAt        DateTime?
  passwordResetToken       String?
  passwordResetTokenExpiry DateTime?
  isBanned                 Boolean   @default(false)
  deletedAt                DateTime?
  hasSetPassword           Boolean   @default(false)
  // Google account "sub" — set on first Google sign-in (new or linked by email).
  googleId                 String?   @unique
  avatarUrl                String?

  reviews       Review[]
  promoteOrders PromoteOrder[]
  toolUpdateRequests ToolUpdateRequest[]
  feedbacks     Feedback[]
  contactMessages ContactMessage[]
  savedTools    ToolSave[]
  adCampaigns   AdCampaign[]
  subscriptions Subscription[]
  researchUsage ResearchUsage[]
  subscriptionInvoices SubscriptionInvoice[]
  socialQueries SocialQuery[]
  articles      Article[]
  postSubmissions PostSubmission[]
  gpts            Gpt[]

  // Emailed links look the user up by the token's hash (server/utils/accountEmails.ts).
  @@index([verificationToken])
  @@index([passwordResetToken])
  @@map("User")
}

// A message sent from Dashboard → Feedback, handled by admins.
model Feedback {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           FeedbackType
  message        String         // up to 1000 characters (checked by the API)
  // Optional screenshot / screen recording, stored with the other uploads.
  attachmentUrl  String?        // key in the private "feedback" storage, served by /api/feedback/<id>/attachment
  attachmentName String?        // original file name, for display
  attachmentSize Int?           // bytes
  attachmentType String?        // MIME type
  status         FeedbackStatus @default(NEW)
  adminNote      String?        // internal, never shown to the user
  // Context that helps reproduce an issue.
  locale         String?
  userAgent      String?
  resolvedAt     DateTime?      // set when status becomes RESOLVED / CLOSED
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // "My feedback", newest first.
  @@index([userId, createdAt])
  // Admin list filtered by status, newest first.
  @@index([status, createdAt])
  @@map("Feedback")
}

// Messages from the public Contact page. Guests can write too (userId null); a
// signed-in sender is linked so the message shows under Dashboard → My inquiries.
// A tool a user saved (the star on a tool page; Dashboard → Saved AIs). Tool.collectionCount
// is the number of these rows, kept in step by POST /api/tools/<slug>/save.
model ToolSave {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolId    String
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, toolId])
  // "Saved AIs", newest first.
  @@index([userId, createdAt])
  @@index([toolId])
  @@map("ToolSave")
}

model ContactMessage {
  id        String         @id @default(cuid())
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String
  subject   ContactSubject
  message   String         // 10–5000 characters (checked by the API)
  status    ContactStatus  @default(NEW)
  reply     String?        // the admin's answer: emailed to the sender and shown in their inquiries
  repliedAt DateTime?
  locale    String?
  ipHash    String?        // HMAC of the sender's IP, for rate limiting — never the raw address
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // "My inquiries", newest first.
  @@index([userId, createdAt])
  // Admin inbox filtered by status, newest first.
  @@index([status, createdAt])
  // Rate limits (per IP / per email address).
  @@index([ipHash, createdAt])
  @@index([email, createdAt])
  @@map("ContactMessage")
}

// One row per Stripe Checkout session from the promote pages (submit AI,
// advertise, guest post, update AI, submit GPT). The webhook flips
// PENDING → PAID exactly once, so a re-delivered event can't fulfil twice.
model PromoteOrder {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String    // submit-ai | advertise | guest-post | update-ai | submit-gpt
  payload         Json      // validated order details (tool, URL, credits, clicks…)
  stripeSessionId String    @unique
  amount          Int       // cents
  currency        String    @default("usd")
  status          String    @default("PENDING") // PENDING | PAID | EXPIRED
  createdAt       DateTime  @default(now())
  paidAt          DateTime?
  toolId          String?   // submit-ai: the Tool created when the order is paid; advertise: the advertised tool
  campaignId      String?   // advertise: the AdCampaign the clicks went to (refunded with it on rejection)
  // guest-post: unused credits refunded by an admin (server/utils/creditRefunds.ts); the
  // order turns REFUNDED once all of its credits are back.
  refundedCredits Int       @default(0)
  refundedAmount  Int       @default(0) // cents

  @@index([userId])
  @@index([toolId])
  @@index([type, status])
  @@index([campaignId])
  @@map("PromoteOrder")
}

// A paid "Update AI" change to a published tool (only its owner can buy one). Created
// when the order is paid; the owner fills in the new details (stored in `changes`, the
// live listing is untouched), an admin applies them or rejects — a rejection refunds
// the order through Stripe. One payment = one update.
model ToolUpdateRequest {
  id              String    @id @default(cuid())
  toolId          String
  tool            Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId         String    @unique
  status          String    @default("DRAFT") // DRAFT | SUBMITTED | APPLIED | REJECTED
  changes         Json?     // proposed fields: name, logoUrl, images, pricingType, twitterUrl, discordUrl, categorySlugs, content{…}
  rejectionReason String?
  refundId        String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([toolId, status])
  @@index([status])
  @@map("ToolUpdateRequest")
}

model Collection {
  id         String   @id @default(cuid())
  slug       String   @unique
  coverImage String?
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  translations CollectionTranslation[]

  @@map("Collection")
}

model CollectionTranslation {
  id               String   @id @default(cuid())
  collectionId     String
  locale           String
  title            String
  description      String?
  isManualOverride Boolean  @default(false)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  collection Collection @relation(fields: [collectionId], references: [id])

  @@unique([collectionId, locale])
  @@map("CollectionTranslation")
}

// Mirrors the old topaicollection table column-for-column so its rows can be
// imported as-is; joined to Tool by toolSlug (no FK, same as the source).
model ToolAnalyticsData {
  id                           String   @id @default(uuid())
  toolSlug                     String   @unique
  monthlyVisits                Float?
  trafficVisits                Json?    // { "YYYY-MM-01": visits }
  trafficSources               Json?    // { "Direct": 81.7, "Search": 0, ... } — percentages
  engagement                   Json?    // { bounceRate: 0..1, timeOnSite: seconds, pagePerVisit }
  paidKeywords                 Json?
  organicKeywords              Json?
  geography                    Json?
  globalRanking                Int?
  highestTrafficCountry        Int?
  highestTrafficCountryRanking Int?
  category                     String?
  categoryRanking              Int?
  hasGaToken                   Boolean?
  privacyStatus                String?
  relatedApps                  Json?
  employeeRange                String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  desktopVsMobile              Json?
  growthMetrics                Json?    // { trend: number[], change: fraction }
  similarSites                 Json?
  yearFounded                  String?
  history                      Json?
  aiTraffic                    Json?
  aiTrafficHistory             Json?
  topPrompts                   Json?

  @@map("ToolAnalyticsData")
}

model ToolSocialStats {
  id       String @id @default(uuid())
  toolSlug String @unique @map("tool_slug")
  domain                   String?   @map("domain")
  toolName                 String?   @map("tool_name")
  toolHandle               String?   @map("tool_handle")
  website                  String?   @map("website")
  websiteLogo              String?   @map("website_logo")
  whatIsSummary            String?   @map("what_is_summary")
  dataCount                Int       @default(0) @map("data_count")
  relatedInfluencerCount   BigInt    @default(0) @map("related_influencer_count")
  relatedVideoCount        BigInt    @default(0) @map("related_video_count")
  averageViews             Float     @default(0) @map("average_views")
  averageEngagement        Float     @default(0) @map("average_engagement")
  totalViews               BigInt    @default(0) @map("total_views")
  totalEngagement          BigInt    @default(0) @map("total_engagement")
  monthVisitedCount        BigInt    @default(0) @map("month_visited_count")
  tiktokVideoCount         BigInt    @default(0) @map("tiktok_video_count")
  tiktokTotalViews         BigInt    @default(0) @map("tiktok_total_views")
  tiktokAvgViews           Float     @default(0) @map("tiktok_avg_views")
  tiktokTotalLikes         BigInt    @default(0) @map("tiktok_total_likes")
  tiktokTotalComments      BigInt    @default(0) @map("tiktok_total_comments")
  tiktokTotalShares        BigInt    @default(0) @map("tiktok_total_shares")
  youtubeVideoCount        BigInt    @default(0) @map("youtube_video_count")
  youtubeTotalViews        BigInt    @default(0) @map("youtube_total_views")
  youtubeAvgViews          Float     @default(0) @map("youtube_avg_views")
  youtubeTotalLikes        BigInt    @default(0) @map("youtube_total_likes")
  youtubeTotalComments     BigInt    @default(0) @map("youtube_total_comments")
  twitterTweetCount        BigInt    @default(0) @map("twitter_tweet_count")
  twitterTotalViews        BigInt    @default(0) @map("twitter_total_views")
  twitterAvgViews          Float     @default(0) @map("twitter_avg_views")
  twitterTotalLikes        BigInt    @default(0) @map("twitter_total_likes")
  twitterTotalReplies      BigInt    @default(0) @map("twitter_total_replies")
  twitterTotalReposts      BigInt    @default(0) @map("twitter_total_reposts")
  growthAbsolute           BigInt?   @map("growth_absolute")
  growthRate               Float?    @map("growth_rate")
  avgVisitDuration         Int?      @map("avg_visit_duration")
  pagesPerVisit            Float?    @map("pages_per_visit")
  bounceRate               Float?    @map("bounce_rate")
  topRegions               Json?     @map("top_regions")
  newVideosLastWeek        Int       @default(0) @map("new_videos_last_week")
  rank                     Int?      @map("rank")
  lastSyncedAt             DateTime? @map("last_synced_at")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tiktokTotalCollects      BigInt    @default(0) @map("tiktok_total_collects")
  twitterTotalQuotes       BigInt    @default(0) @map("twitter_total_quotes")
  facebookAvgViews         Float     @default(0) @map("facebook_avg_views")
  facebookPostCount        BigInt    @default(0) @map("facebook_post_count")
  facebookTotalComments    BigInt    @default(0) @map("facebook_total_comments")
  facebookTotalLikes       BigInt    @default(0) @map("facebook_total_likes")
  facebookTotalViews       BigInt    @default(0) @map("facebook_total_views")
  instagramAvgViews        Float     @default(0) @map("instagram_avg_views")
  instagramPostCount       BigInt    @default(0) @map("instagram_post_count")
  instagramTotalComments   BigInt    @default(0) @map("instagram_total_comments")
  instagramTotalLikes      BigInt    @default(0) @map("instagram_total_likes")
  instagramTotalViews      BigInt    @default(0) @map("instagram_total_views")
  redditAvgViews           Float     @default(0) @map("reddit_avg_views")
  redditPostCount          BigInt    @default(0) @map("reddit_post_count")
  redditTotalComments      BigInt    @default(0) @map("reddit_total_comments")
  redditTotalLikes         BigInt    @default(0) @map("reddit_total_likes")
  redditTotalViews         BigInt    @default(0) @map("reddit_total_views")

  feeds ToolSocialFeed[]

  @@index([rank])
  @@map("tool_social_stats")
}

model ToolSocialFeed {
  id            String    @id @default(uuid())
  statId        String    @map("stat_id")
  platform      String
  sourceId      String    @map("source_id")
  title         String?
  description   String?
  thumbnailUrl  String?   @map("thumbnail_url")
  videoUrl      String?   @map("video_url")
  duration      Int       @default(0)
  creatorName   String?   @map("creator_name")
  creatorHandle String?   @map("creator_handle")
  publishedAt   DateTime? @map("published_at")
  views         BigInt    @default(0)
  likes         BigInt    @default(0)
  comments      BigInt    @default(0)
  shares        BigInt    @default(0)
  quotes        BigInt?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  collects      BigInt    @default(0)
  interactions  Json?
  metatags      Json?

  stat ToolSocialStats @relation(fields: [statId], references: [id], onDelete: Cascade)

  @@index([statId])
  // Social Listening queries search titles / descriptions with ILIKE '%keyword%'.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "tool_social_feeds_title_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "tool_social_feeds_description_trgm_idx")
  @@map("tool_social_feeds")
}

model ToolifyTool {
  id                  String    @id @default(uuid())
  slug                String    @unique
  name                String
  websiteDomain       String?   @map("website_domain")
  websiteUrl          String?   @map("website_url")
  imageUrl            String?   @map("image_url")
  iconUrl             String?   @map("icon_url")
  tagline             String?
  whatIs              String?   @map("what_is")
  whatIsSummary       String?   @map("what_is_summary")
  howToUse            String?   @map("how_to_use")
  bestFor             String?   @map("best_for")
  tags                String?
  pricingTags         String[]  @map("pricing_tags")
  monthVisitedCount   BigInt?   @map("month_visited_count")
  collectedCount      Int?      @map("collected_count")
  reviewScore         Decimal?  @map("review_score") @db.Decimal(3, 2)
  reviewCount         Int?      @map("review_count")
  ratingCount         Int?      @map("rating_count")
  toolifyCreatedAt    DateTime? @map("toolify_created_at") @db.Timestamptz(6)
  toolifyUpdatedAt    DateTime? @map("toolify_updated_at") @db.Timestamptz(6)
  sourceUrl           String    @map("source_url")
  scrapedAt           DateTime  @map("scraped_at") @db.Timestamptz(6)
  isSync              Int       @default(0) @map("is_sync")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  categories       Json? @map("categories") @db.JsonB
  coreFeatures     Json? @map("core_features") @db.JsonB
  useCases         Json? @map("use_cases") @db.JsonB
  pricingPlans     Json? @map("pricing_plans") @db.JsonB
  faqs             Json? @map("faqs") @db.JsonB
  trafficSnapshots Json? @map("traffic_snapshots") @db.JsonB
  analyticsData    Json? @map("analytics_data") @db.JsonB

  @@map("ToolifyTool")
}

model PhProductTool {
  id               Int      @id @default(autoincrement())
  phId             String   @unique @map("ph_id")          // "504757" (từ key Product504757)
  slug             String   @unique
  name             String
  tagline          String
  description      String?  @db.Text

  websiteUrl       String?  @map("website_url")
  websiteDomain    String?  @map("website_domain")
  cleanUrl         String?  @map("clean_url")
  logoUuid         String?  @map("logo_uuid")

  twitterUrl       String?  @map("twitter_url")
  linkedinUrl      String?  @map("linkedin_url")
  githubUrl        String?  @map("github_url")
  facebookUrl      String?  @map("facebook_url")
  instagramUrl     String?  @map("instagram_url")

  pricingType      String?  @map("pricing_type")
  employeeSize     String?  @map("employee_size")
  fundingAmount    String?  @map("funding_amount")
  wasInYCombinator Boolean  @default(false) @map("was_in_yc")
  isClaimed        Boolean  @default(false) @map("is_claimed")
  isTopProduct     Boolean  @default(false) @map("is_top_product")

  reviewsCount          Int?     @map("reviews_count")
  reviewsRating         Decimal? @db.Decimal(3, 2) @map("reviews_rating")
  detailedReviewsCount  Int?     @map("detailed_reviews_count")
  detailedReviewsRating Decimal? @db.Decimal(3, 2) @map("detailed_reviews_rating")
  followersCount        Int?     @map("followers_count")

  categories Json? @db.JsonB @map("categories") // [{slug,name,path}]
  media      Json? @db.JsonB @map("media")      // [{imageUuid,mediaType,originalWidth,originalHeight}]
  launches   Json? @db.JsonB @map("launches")   // [{slug,name,tagline,launchedAt,dailyRank,weeklyRank,monthlyRank,commentsCount,makers:[{name,username,avatarUrl}]}]
  badges     Json? @db.JsonB @map("badges")     // [{type,awardedAt}]
  reviews    Json? @db.JsonB @map("reviews")

  phCategories PhCategory[] @relation("PhProductCategories")

  sourceUrl String   @map("source_url")
  scrapedAt DateTime @map("scraped_at")
  isSync    Int      @default(0) @map("is_sync")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("PhProductTool")
}

model ToolifyCategory {
  id               String    @id @default(cuid())

  categoryId       Int       @unique @map("category_id") // category_detail.id
  handle           String    @unique                     // slug, dùng để upsert

  name             String
  nameLocales      Json?     @map("name_locales") @db.JsonB
  description      String?   @db.Text
  type             Int?      // 1 = category lá, 2 = category-cha (nhóm lớn) -- xác nhận live

  order            Int?
  toolCount        Int?      @map("tool_count")
  topToolCount     Int?      @map("top_tool_count")
  topVisitedCount  Int?      @map("top_visited_count")

  toolifyCreatedAt DateTime? @map("toolify_created_at") @db.Timestamptz(6)
  toolifyUpdatedAt DateTime? @map("toolify_updated_at") @db.Timestamptz(6)

  sourceUrl        String?   @map("source_url")
  scrapedAt        DateTime? @map("scraped_at") @db.Timestamptz(6)
  isSync           Int       @default(0) @map("is_sync")

  // Cây tự tham chiếu: 1 category-cha có nhiều category con
  parentCategoryId Int?              @map("parent_category_id") // = group_id lấy từ chính trang category đó, null nếu là cha cao nhất
  parent           ToolifyCategory?  @relation("CategoryTree", fields: [parentCategoryId], references: [categoryId])
  children         ToolifyCategory[] @relation("CategoryTree")

  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([parentCategoryId])
  @@map("ToolifyCategory")
}

model PhCategory {
  id               String       @id @default(cuid())
  categoryId       Int?         @unique @map("category_id") // ProductCategory.id từ PH -- nullable, giống Toolify, để product-ingestion tự tạo bản ghi tạm nếu chưa crawl category riêng
  slug             String       @unique                     // khoá nối chung với PhProductTool
  name             String
  description      String?      @db.Text
  path             String?

  parentCategoryId Int?         @map("parent_category_id")
  parent           PhCategory?  @relation("PhCategoryTree", fields: [parentCategoryId], references: [categoryId])
  children         PhCategory[] @relation("PhCategoryTree")

  products         PhProductTool[] @relation("PhProductCategories")

  isSync           Int          @default(0) @map("is_sync")

  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([parentCategoryId])
  @@map("PhCategory")
}

model CapterraTool {
  id              String    @id @default(uuid())
  capterraId      Int       @unique              // 10265222 từ /p/10265222/TFives/
  slug            String                         // "TFives"
  url             String
  name            String
  websiteUrl      String?                        // vendor's own site (Capterra's "Visit website")

  categoryName    String?                        // breadcrumb cấp 2, vd "Audit Software"
  categoryUrl     String?

  lastUpdated     DateTime? @db.Date             // "Last updated on <date>" trên trang
                                                 // (ngày sửa profile, KHÔNG phải ngày tạo)
  description     String?   @db.Text
  usedFor         Json?                          // string[]

  ratingOverall   Float?                         // null khi reviewCount = 0
  reviewCount     Int       @default(0)
  startingPrice   String?                        // free text: "Contact vendor for pricing", "R$149.9 ..."
  freeTrial       Boolean   @default(false)
  freeVersion     Boolean   @default(false)
  pricingPlans    Json?                          // [{name, price, unit}]

  alternatives    Json?                          // [{name, rating, reviewCount, startingPrice, positivePct}]
  headToHead      Json?                          // {name, rating, reviewCount, startingPrice}
  support         Json?                          // string[]
  training        Json?                          // string[]
  deployment      Json?                          // string[]
  typicalUsers    Json?                          // string[]

  features        Json?                          // [{name, description}]
  ratingBreakdown Json?                          // {"5":9,"4":4,...}
  subRatings      Json?                          // {easeOfUse, valueForMoney, customerService, features}
  reviews         Json?                          // [{reviewer, role, industry, title, date, overallRating, ... pros, cons}]
  faqs            Json?                          // [{section, question, answer}]

  sourceUrl       String?
  scrapedAt       DateTime?
  isSync          Int       @default(0) @map("is_sync")
  createdAt       DateTime  @default(now())      // = ngày crawler của mình thấy tool lần đầu
  updatedAt       DateTime  @updatedAt

  @@index([lastUpdated])
  @@index([categoryName])
}

// Pay-per-click ads (server/utils/ads.ts). One campaign per user, tool and tier; buying
// more clicks for the same tool and tier tops it up. Every charged click takes one from
// clicksRemaining; at 0 the campaign is EXHAUSTED until the next top-up.
//
//   paid order → ACTIVE (standard, landing URL on the tool's own site)
//              → PENDING_REVIEW (featured, or a landing URL on another site) → admin approves / rejects (refund)
// Changing the landing URL of a running campaign keeps it running on the approved URL;
// the new one waits in pendingLandingUrl when it needs a review.
model AdCampaign {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolId            String
  tool              Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  tier              String    // STANDARD | FEATURED
  status            String    @default("PENDING_REVIEW") // PENDING_REVIEW | ACTIVE | PAUSED | EXHAUSTED | REJECTED
  pausedByAdmin     Boolean   @default(false) // an admin pause can't be resumed by the owner
  landingUrl        String?   // approved target; null = the tool's website
  pendingLandingUrl String?   // a change waiting for an admin
  rejectionReason   String?
  clicksPurchased   Int       @default(0)
  clicksRemaining   Int       @default(0)
  clicks            Int       @default(0) // charged clicks
  impressions       Int       @default(0)
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  adClicks AdClick[]

  @@unique([userId, toolId, tier])
  // Slot picking: every running campaign.
  @@index([status, clicksRemaining])
  @@index([toolId])
  @@map("AdCampaign")
}

// One row per click on a sponsored slot, charged or not (repeat visitor, bot, no balance).
model AdClick {
  id         String     @id @default(cuid())
  campaignId String
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  placement  String?
  ipHash     String
  charged    Boolean
  createdAt  DateTime   @default(now())

  // "Same visitor clicked this campaign in the last 24h?" and the per-day report.
  @@index([campaignId, ipHash, createdAt])
  @@index([campaignId, createdAt])
  @@map("AdClick")
}

// A paid Research Plan subscription, mirrored from Stripe (Stripe is the source of truth;
// the webhook keeps this row in step). A user keeps one row per Stripe subscription, so
// past ones stay as history; the current one is the newest whose status gives access
// (active / trialing / past_due while Stripe retries). No row = the Free plan.
// Separate from ads and promote orders, which are one-off payments (PromoteOrder).
model Subscription {
  id                   String          @id @default(cuid())
  userId               String
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 ResearchPlan
  interval             BillingInterval
  // Stripe's own status, as is: incomplete | incomplete_expired | trialing | active |
  // past_due | canceled | unpaid | paused
  status               String
  stripeSubscriptionId String          @unique
  stripePriceId        String
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean         @default(false) // cancelled, runs until currentPeriodEnd
  canceledAt           DateTime?
  endedAt              DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  invoices SubscriptionInvoice[]

  // "The user's current subscription": by user, newest first, filtered on status.
  @@index([userId, createdAt])
  @@index([status, currentPeriodEnd])
  @@map("Subscription")
}

// What one user may use and has used in one quota period: a billing period of their
// subscription, or a calendar month on the Free plan. The limits are copied in when the
// period starts, so a later price/quota change in code doesn't rewrite a running period;
// an upgrade mid-period raises them in place.
model ResearchUsage {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               String // FREE | STARTER | PROFESSIONAL | ENTERPRISE, at the time
  periodStart        DateTime
  periodEnd          DateTime
  dataCreditsLimit   Int
  dataCreditsUsed    Int      @default(0)
  socialQueriesLimit Int
  socialQueriesUsed  Int      @default(0) // unused: active SocialQuery rows are counted live
  exportRowsLimit    Int      @default(0)
  exportRowsUsed     Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  items ResearchUsageItem[]

  // One row per user and period; spending locks it, so parallel requests can't overspend.
  @@unique([userId, periodStart])
  @@index([userId, periodEnd])
  @@map("ResearchUsage")
}

// One Stripe invoice of a subscription (first payment and every renewal), for
// Dashboard → Payment & Invoice. Upserted by stripeInvoiceId, so a re-delivered webhook
// can't add it twice.
model SubscriptionInvoice {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId   String?
  subscription     Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  stripeInvoiceId  String           @unique
  amount           Int // cents, what was charged
  currency         String           @default("usd")
  status           String // Stripe invoice status: draft | open | paid | uncollectible | void
  plan             ResearchPlan?
  interval         BillingInterval?
  periodStart      DateTime?
  periodEnd        DateTime?
  hostedInvoiceUrl String?
  invoicePdf       String?
  paidAt           DateTime?
  createdAt        DateTime         @default(now())

  @@index([userId, createdAt])
  @@map("SubscriptionInvoice")
}

// A data row already paid for in a quota month (key e.g. "insights:2026-09:<tool slug>"):
// loading it again in the same month costs nothing.
model ResearchUsageItem {
  id        String        @id @default(cuid())
  usageId   String
  usage     ResearchUsage @relation(fields: [usageId], references: [id], onDelete: Cascade)
  key       String
  createdAt DateTime      @default(now())

  @@unique([usageId, key])
  @@map("ResearchUsageItem")
}

// A Social Listening query: a saved topic (1–5 keywords) matched against the crawled
// social posts (ToolSocialFeed title / description). Plans limit how many are active at
// once; pausing or deleting one frees its slot. No Data Credits are spent on them.
model SocialQuery {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  keywords     String[]
  active       Boolean   @default(true)
  lastViewedAt DateTime? // posts collected after this are "new"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, active])
  @@map("SocialQuery")
}

// A public article under /ai-news: written by our editors (EDITORIAL) or a customer's paid
// guest post (GUEST_POST, created when an admin publishes the submission). Content is
// Markdown, rendered on display (server/utils/articles.ts) — so the link policy
// (dofollow / sponsored) applies to every article at once.
model Article {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  excerpt      String?
  content      String    // Markdown ("" for a link item)
  // A link item: the card's title opens this outside page (no page of ours, not in the
  // sitemap, can't take link inserts). Null = a normal article.
  externalUrl  String?
  coverUrl     String?
  kind         String    @default("EDITORIAL") // EDITORIAL | GUEST_POST
  status       String    @default("DRAFT")     // DRAFT | PUBLISHED
  authorId     String?
  author       User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName   String?   // byline shown on the page
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  submissions  PostSubmission[] @relation("SubmissionArticle")

  // /ai-news list: published, newest first.
  @@index([status, publishedAt])
  @@map("Article")
}

// A customer's paid request (Dashboard → Posts / Links), paid with User.postCredits:
//   GUEST_POST (2 credits)  → their article, published by an admin as an Article
//   LINK_INSERT (1 credit)  → their link placed by an admin in an existing Article
// Credits are taken on submit; a rejection or a withdrawal gives them back.
//   PENDING → PUBLISHED | REJECTED, or CHANGES_REQUESTED → (edited) PENDING …
model PostSubmission {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String    // GUEST_POST | LINK_INSERT
  status      String    @default("PENDING") // PENDING | CHANGES_REQUESTED | PUBLISHED | REJECTED | WITHDRAWN
  credits     Int       // spent on submit, refunded on rejection / withdrawal
  // guest post
  title       String?
  excerpt     String?
  content     String?   // Markdown
  coverUrl    String?
  // link insert
  targetUrl   String?
  anchorText  String?
  note        String?   // where / how to place it
  // the article: requested (link insert) / where it ended up (both kinds)
  articleId   String?
  article     Article?  @relation("SubmissionArticle", fields: [articleId], references: [id], onDelete: SetNull)
  adminNote   String?   // reason for a rejection / what to change
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, submittedAt])
  @@map("PostSubmission")
}

// GPT Store (/gpts). A paid "Submit GPT" order creates one in PENDING; its name,
// description and image are fetched from the GPT's public page (server/utils/gpts.ts),
// an admin reviews / edits it and publishes it — or rejects it, refunding the order.
model Gpt {
  id              String    @id @default(cuid())
  slug            String    @unique
  gizmoId         String    // "g-abc123" from chatgpt.com/g/g-abc123-name
  url             String    // https://chatgpt.com/g/<gizmoId>
  name            String    @default("")
  description     String    @default("") // short, shown on cards
  content         String?   // optional longer Markdown text for the detail page
  iconUrl         String?
  author          String?
  category        String    @default("other") // shared/gpts.ts GPT_CATEGORIES
  status          String    @default("PENDING") // PENDING | PUBLISHED | HIDDEN | REJECTED
  // Last automatic fetch of the GPT page: QUEUED | OK | NOT_FOUND | FAILED
  fetchStatus     String    @default("QUEUED")
  fetchedAt       DateTime?
  rejectionReason String?
  ownerId         String?
  owner           User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  orderId         String?   @unique
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([status, category, publishedAt])
  @@index([gizmoId])
  @@index([ownerId, createdAt])
  @@map("Gpt")
}
